# Copy this file to /etc/owui-mcp-spawner.env and set a strong password.
# Restrict permissions: sudo chmod 600 /etc/owui-mcp-spawner.env
#
# Option A — plain-text password (hashed with SHA-256 at startup):
MCP_MANAGER_PASSWORD=change-me

# Option B — pre-hashed SHA-256 digest (takes precedence over the above):
# MCP_MANAGER_PASSWORD_HASH=your-sha256-hex-digest-here

# ── Per-user identity (optional) ──────────────────────────────────────────
# Answers a different question from everything above: not "may this client
# connect" but "which person is calling". Only needed when instances run with
# identity_mode = optional/required.
#
# The same secret OpenWebUI signs its forwarded user token with
# (FORWARD_USER_INFO_HEADER_JWT_SECRET there, plus
# ENABLE_FORWARD_USER_INFO_HEADERS=true):
# MCP_USER_JWT_SECRET=the-same-secret-as-in-openwebui
#
# Without a shared secret: accept OpenWebUI's plain user headers instead.
# They are a claim, not a proof — anyone who can reach an instance's port
# with the MCP Bearer token can write them. It separates the users of one
# OpenWebUI installation from each other, nothing more.
# MCP_USER_TRUST_HEADERS=1
#
# Runners read these once at startup: after a change, restart each instance,
# not just the manager.
